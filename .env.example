# =================================================================
# Reliable Webhook Delivery Service — Environment Configuration
# =================================================================

# Server
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webhooks
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20

# Security & Network Settings
# Set to 'true' only in local development to test against localhost/private IPs
ALLOW_INTERNAL_URLS=false

# Delivery Worker Configuration
WORKER_ENABLED=true
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_SECONDS=120
HTTP_CONNECT_TIMEOUT_MS=5000
HTTP_READ_TIMEOUT_MS=10000

# Exponential Backoff & Retry Policy
RETRY_MAX_ATTEMPTS=8
RETRY_BASE_DELAY_SECONDS=30
RETRY_MAX_DELAY_SECONDS=21600
RETRY_JITTER_PERCENT=0.15

# Per-Endpoint Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_SECONDS=60
